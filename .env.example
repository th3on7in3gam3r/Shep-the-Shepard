# Public site URL (SEO sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://shep-the-shepard.vercel.app

# Optional privacy-friendly analytics (https://plausible.io)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=shep-the-shepard.vercel.app

# Server-only. Copy to .env.local and fill in your key.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — defaults shown below
# OPENAI_MODEL=gpt-4o-mini
# Use gpt-4o for richer, more nuanced replies (higher cost)
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.75

# Optional chat rate limits (defaults: 30 requests / 60 seconds per IP)
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SEC=60

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer publishable key (if anon JWT is not used)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=